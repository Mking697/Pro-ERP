# --- Google Service Account (Sheets + Drive) ---
# Create in Google Cloud Console > IAM & Admin > Service Accounts.
# Share your System spreadsheet, and every module sheet / Drive folder you connect
# later from Admin > Settings, with this service account's email as an Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Paste the full private key from the downloaded JSON, keeping \n escape sequences as-is.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# --- Google Sheets ---
# The System spreadsheet's ID from its URL: /d/<THIS_PART>/edit
# (Users + Settings tabs live here; all other sheets are connected from Admin > Settings.)
GOOGLE_SHEET_ID=

# --- Auth ---
# Any long random string. Generate one with: openssl rand -base64 32
JWT_SECRET=

# --- WhatsApp reminders cron (optional) ---
# Any long random string. Set the same value in Vercel's Cron settings (or as an env var)
# so /api/whatsapp/send-reminders can tell a real Vercel Cron call apart from a stranger's request.
# Not needed for local dev or for the manual "Send Reminders Now" button (that uses your admin login instead).
CRON_SECRET=
