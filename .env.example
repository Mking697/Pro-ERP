# --- Database (required) ---
# Neon's pooled Postgres connection string (https://neon.tech). The app cannot render a
# single page — including login — without this set. Any Postgres 14+ works if you'd
# rather self-host, but this codebase uses the `drizzle-orm/neon-http` driver.
DATABASE_URL=

# --- Auth (required) ---
# Any long random string. Generate one with: openssl rand -base64 32
# Signs the JWT session cookie (jose, edge-compatible).
JWT_SECRET=

# --- Attachment storage (required for uploads) ---
# Created for you when you add a Blob store in the Vercel dashboard and connect it to
# this project — Vercel injects this variable automatically in that environment, you
# only need to paste it by hand for local development. Every attachment (task proofs,
# invoices, POs, PDFs, org logos) goes through Vercel Blob unconditionally.
BLOB_READ_WRITE_TOKEN=

# --- Platform operator (optional) ---
# Comma-separated emails allowed to see /platform, which lists every organization on this
# install and can suspend/delete one, plus read the server error log. Deliberately an env
# var and not a role or database column: an organization's own Admin can already reach
# code that writes to tenant data, so a stored flag could be granted to oneself. Empty
# means nobody has platform access.
PLATFORM_ADMIN_EMAILS=

# --- Cron (optional, but needed for scheduled jobs) ---
# Any long random string. Set the same value in Vercel's Cron settings (Vercel injects it
# as a header on scheduled calls automatically once set there — vercel.json defines the
# schedule). A request carrying this secret runs a job (recurring tasks, leave activation/
# reversion, WhatsApp reminders) for every active organization; the same route triggered
# from the UI runs only for the signed-in admin's own org.
CRON_SECRET=

# --- WhatsApp (ChatXFlow) — configured per-organization, not here ---
# There is no global WhatsApp env var: each org pastes its own ChatXFlow API token from
# /admin/settings, stored in that org's own `settings` table row, never in this file.
