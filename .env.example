# --- Database (required) ---
# A standard Postgres connection string. As of 2026-10-10 this app is self-hosted
# (Hostinger VPS) with its own local Postgres — this is no longer a Neon project. The
# app cannot render a single page — including login — without this set.
DATABASE_URL=

# --- Local Neon-driver proxy (required on a self-hosted/VPS deployment) ---
# The codebase still uses @neondatabase/serverless + drizzle-orm/neon-http for historical
# reasons (see CLAUDE.md's "Infra migration" section). That driver only speaks to Neon's
# own cloud data-proxy by default, so a self-hosted Postgres needs a local translator
# sidecar: ghcr.io/timowilhelm/local-neon-http-proxy, run as a Docker container next to
# the app (see CLAUDE.md for the exact `docker run` command and pg_hba.conf/superuser
# password prerequisites). Point this at that sidecar's HTTP port. Leave unset for a real
# Neon-hosted deployment — the driver's normal cloud behavior is untouched when this is
# empty (see src/db/local-proxy.ts).
DB_LOCAL_PROXY_URL=

# --- Auth (required) ---
# Any long random string. Generate one with: openssl rand -base64 32
# Signs the JWT session cookie (jose, edge-compatible).
JWT_SECRET=

# --- Attachment storage (required for uploads) ---
# As of 2026-10-10 attachments/logos are written to local disk on the app server
# (src/lib/storage.ts), not Vercel Blob — set these two:
# UPLOADS_DIR: absolute path on the server's filesystem to write into, e.g.
#   /opt/pro-erp-data/uploads (keep this OUTSIDE the git-managed app directory so a
#   `git pull`/redeploy never touches it).
# PUBLIC_UPLOADS_BASE_URL: the public base URL your reverse proxy serves that directory
#   back out at (e.g. https://your-domain/uploads — see CLAUDE.md for the Nginx
#   `location /uploads/ { alias UPLOADS_DIR; }` block). Defaults to the relative path
#   "/uploads" if unset, which works behind any domain.
UPLOADS_DIR=
PUBLIC_UPLOADS_BASE_URL=

# --- Platform operator (optional) ---
# Comma-separated emails allowed to see /platform, which lists every organization on this
# install and can suspend/delete one, plus read the server error log. Deliberately an env
# var and not a role or database column: an organization's own Admin can already reach
# code that writes to tenant data, so a stored flag could be granted to oneself. Empty
# means nobody has platform access.
PLATFORM_ADMIN_EMAILS=

# --- Cron (optional, but needed for scheduled jobs) ---
# Any long random string. On the current self-hosted deployment this is triggered by a
# system cron job (or similar scheduler) hitting the route with this secret as a header
# instead of Vercel Cron. A request carrying this secret runs a job (recurring tasks,
# leave activation/reversion, WhatsApp reminders) for every active organization; the same
# route triggered from the UI runs only for the signed-in admin's own org.
CRON_SECRET=

# --- WhatsApp (ChatXFlow) — configured per-organization, not here ---
# There is no global WhatsApp env var: each org pastes its own ChatXFlow API token from
# /admin/settings, stored in that org's own `settings` table row, never in this file.
