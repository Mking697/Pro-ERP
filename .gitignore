# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local MCP server config (holds live API keys)
.mcp.json

# typescript
*.tsbuildinfo
next-env.d.ts

# Local AI-tool state and installed skill bundles — reproducible via their own
# installers, machine-specific, never part of the application.
.agents/
.claude/

# marketing/ is an isolated video-production side-workspace (own package.json) —
# its own dependency tree and rendered video output are large and reproducible
# from marketing/remotion's source, never part of the production app.
marketing/node_modules/
marketing/output/

# Personal session resume notes, not application content.
/RESUME-PROMPT.txt
